# Copy to .env and adjust. Every value here is also the built-in default,
# so the proxy runs with no configuration at all.

# --- server ---------------------------------------------------------------
PORT=8080
LOG_LEVEL=info          # debug | info | warn | error
LOG_FORMAT=text         # text | json
SHUTDOWN_TIMEOUT=10s

# --- rate limit policy ----------------------------------------------------
# RATE_LIMIT_RPS is the number of requests allowed inside one window. With the
# default one second window that is literally requests per second; with a
# longer window the sustained rate is RATE_LIMIT_RPS / WINDOW_SIZE_SECONDS.
RATE_LIMIT_RPS=10
WINDOW_SIZE_SECONDS=1

# --- redis ----------------------------------------------------------------
# Set REDIS_ADDR=disabled to run purely on the in-memory limiter.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=rl:
REDIS_TIMEOUT=200ms     # per-call budget before failing over

# --- fallback / circuit breaker -------------------------------------------
FAILURE_THRESHOLD=3     # consecutive Redis failures before the circuit opens
FALLBACK_COOLDOWN=5s    # how long the circuit stays open
PROBE_INTERVAL=2s       # background Redis health check
CLEANUP_INTERVAL=30s    # in-memory limiter TTL sweep

# --- upstream -------------------------------------------------------------
# mock://internal serves a built-in JSON echo handler.
# Point this at a real origin, e.g. https://httpbin.org/anything
UPSTREAM_URL=mock://internal
UPSTREAM_TIMEOUT=30s
# Allow the upstream target to be changed at runtime from the dashboard. Handy
# for a demo; it is an SSRF / open-relay lever, so turn it off in a hardened
# deployment and set the target only through UPSTREAM_URL.
UPSTREAM_EDITABLE=true
# Only enable when the proxy sits behind a load balancer you control,
# otherwise clients can spoof X-Forwarded-For to dodge their limit.
TRUST_PROXY_HEADERS=false

# --- dashboard ------------------------------------------------------------
DASHBOARD_ENABLED=true
METRICS_WINDOW_SECONDS=60
# Bind the dashboard + control API to their own address instead of the public
# port. STRONGLY recommended in production: the public port then serves only
# proxied traffic, so the unauthenticated dashboard is never exposed. Leave
# empty to share the public port (fine for local/demo).
# Example: 127.0.0.1:9090  (reachable only from the host / an SSH tunnel)
ADMIN_ADDR=
# Namespaces every control-plane route so the proxy cannot swallow paths that
# belong to the upstream application. The dashboard then lives at
# <ADMIN_PREFIX>/dashboard and the API at <ADMIN_PREFIX>/api/... .
# Set it to an empty value only when the upstream owns no /api or /dashboard.
ADMIN_PREFIX=/_rl
